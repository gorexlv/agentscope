#!/usr/bin/env python3
"""
agentscope — 本地 AI Agent 会话与后台进程监控/清理工具

解决的核心问题：
  Claude Code / Codex 等 CLI Agent 会话结束后，其派生的子进程
  （MCP server、dev server、language server、node 进程等）不会随之退出，
  变成 ppid=1 的孤儿，长期堆积直到拖垮整台机器。

原理（已在 macOS 26.6 arm64 实测验证）：
  - 子进程继承父进程的进程组（pgid）
  - 父进程退出后子进程成为孤儿，但保留原 pgid
  - killpg(pgid) 可一次性终止整组残留进程

用法：
  agentscope scan              列出 Agent 会话与残留进程组
  agentscope scan --json       JSON 输出
  agentscope watch             持续监控，检测到孤儿组即清理
  agentscope clean             清理孤儿进程组（需 --yes 确认）
  agentscope clean --dry-run   预演，不实际终止
  agentscope tree <pgid>       查看某个进程组的完整构成
"""

import argparse
import ctypes
import ctypes.util
import collections
import json
import os
import signal
import subprocess
import sys
import time

# 让脚本无论从哪里调用都能找到 agentscope_lib 包
# 优先级：① 同级仓库目录（开发态）  ② ~/.local/lib（安装态）
_PKG_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
for _cand in (_PKG_DIR, os.path.join(os.path.expanduser("~"), ".local", "lib")):
    if os.path.isdir(os.path.join(_cand, "agentscope_lib")) and _cand not in sys.path:
        sys.path.insert(0, _cand)
        break

VERSION = "1.1.0"

# ─────────────────────────────────────────────────────────────
# libproc 绑定：绕过 ps/top 的沙箱限制，直接读内核进程表
# ─────────────────────────────────────────────────────────────

_libc = ctypes.CDLL(ctypes.util.find_library("c"))
_libproc = ctypes.CDLL("/usr/lib/libSystem.B.dylib")

_libproc.proc_listallpids.argtypes = [ctypes.c_void_p, ctypes.c_int]
_libproc.proc_listallpids.restype = ctypes.c_int
_libproc.proc_pidinfo.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_uint64,
                                  ctypes.c_void_p, ctypes.c_int]
_libproc.proc_pidinfo.restype = ctypes.c_int

_libc.getpgid.argtypes = [ctypes.c_int]
_libc.getpgid.restype = ctypes.c_int
_libc.getpid.argtypes = []
_libc.getpid.restype = ctypes.c_int

PROC_PIDTBSDINFO = 3

# ─────────────────────────────────────────────────────────────
# Agent / 开发工具进程特征
# ─────────────────────────────────────────────────────────────

AGENT_MARKERS = (
    # CLI Agent 本体
    "claude", "codex", "zcode", "kimi", "cursor-agent", "aider",
    "gemini", "qwen", "opencode", "goose", "amp",
    # MCP server
    "mcp-server", "mcp_server", "mcp-server-darwin",
    # 语言服务 / 构建
    "language-server", "typescript", "tsserver", "esbuild", "vite",
    "node", "deno", "bun",
    # 包管理 / 任务
    "pnpm", "npm", "yarn", "tsup", "tsx",
    # 交互 shell（Agent 常通过 fish/zsh 起子进程）
    "fish", "zsh", "bash",
)

# 永远不碰的应用（宿主自身 / 桌面端）
PROTECT_APPS = (
    "WorkBuddy", "Logseq", "ChatGPT", "Claude.app", "LarkSuite",
    "Orca", "Paseo", "Raycast", "OrbStack", "Terminal", "iTerm",
)

# 检测到就说明是"宿主型"进程（不该被当成 agent 残留）
DESKTOP_HOSTS = ("workbuddy", "logseq", "chatgpt", "lark", "orca",
                 "paseo", "raycast", "orbstack", "iterm")

# Agent 会话通常在"工作区目录"里跑。这些路径前缀下的 cwd 视为工作区。
# 可用环境变量 AGENTSCOPE_WORKSPACES 覆盖（冒号分隔）。
def _default_workspace_roots():
    home = os.path.expanduser("~")
    return (
        os.path.join(home, "Workspace"),
        os.path.join(home, "Worksapce"),      # 兼容常见的拼写错误目录
        os.path.join(home, "orca", "workspaces"),
        os.path.join(home, ".codex", "worktrees"),
        os.path.join(home, ".claude"),
        os.path.join(home, "Desktop"),
        os.path.join(home, "Documents"),
        os.path.join(home, "Projects"),
    )


_env_ws = os.environ.get("AGENTSCOPE_WORKSPACES", "").strip()
WORKSPACE_ROOTS = (
    tuple(p for p in _env_ws.split(os.pathsep) if p)
    if _env_ws else _default_workspace_roots()
)

# 明确排除的宿主型进程名（桌面应用 Helper，不是 CLI Agent）
EXCLUDE_COMM = (
    "browser helper", "ego helper", "codex (service)", "codex (renderer",
    "claude helper", "lark helper", "electron helper", "workbuddy helper",
    "logseq helper", "helper (renderer", "helper (plugin)",
)


def _i32(b, off):
    return int.from_bytes(b[off:off + 4], "little", signed=True)


def list_pids():
    n = _libproc.proc_listallpids(None, 0)
    if n <= 0:
        return []
    buf = ctypes.create_string_buffer(n * 4)
    c = _libproc.proc_listallpids(buf, n * 4)
    return [int.from_bytes(buf.raw[i * 4:i * 4 + 4], "little") for i in range(c)]


def proc_bsdinfo(pid):
    raw = ctypes.create_string_buffer(1024)
    r = _libproc.proc_pidinfo(pid, PROC_PIDTBSDINFO, 0, raw, 1024)
    if r <= 0:
        return None
    d = raw.raw[:r]
    if len(d) < 96:
        return None
    return {
        "pid": _i32(d, 12),
        "ppid": _i32(d, 16),
        "uid": _i32(d, 20),
        "status": _i32(d, 4),
        "comm": d[48:64].split(b"\0")[0].decode(errors="replace"),
        "name": d[64:96].split(b"\0")[0].decode(errors="replace"),
    }


def scan_processes():
    """返回 {pid: {...}} 全量进程快照（含 pgid）"""
    out = {}
    for pid in list_pids():
        b = proc_bsdinfo(pid)
        if b and b["pid"] == pid:
            g = _libc.getpgid(pid)
            b["pgid"] = g if g >= 0 else -1
            out[pid] = b
    return out


_cwd_cache = {}


def load_cwds_batch(pids):
    """一次性获取所有进程的 cwd —— 比逐个调用 lsof 快 60 倍以上。

    逐进程调 lsof 在 500+ 进程时需要 24 秒，hook 有超时限制，必须批量。
    用 lsof 的机器可读格式 -F pn：先输出 p<pid>，再输出 n<cwd>。
    """
    global _cwd_cache
    _cwd_cache = {}
    if not pids:
        return _cwd_cache
    try:
        r = subprocess.run(["lsof", "-a", "-d", "cwd", "-F", "pn", "-p",
                            ",".join(str(p) for p in pids)],
                           capture_output=True, text=True, timeout=30).stdout
        cur = None
        for line in r.splitlines():
            if line.startswith("p"):
                cur = int(line[1:]) if line[1:].isdigit() else None
            elif line.startswith("n") and cur is not None:
                _cwd_cache[cur] = line[1:]
                cur = None
    except Exception:
        pass
    return _cwd_cache


def proc_cwd(pid):
    if pid in _cwd_cache:
        return _cwd_cache[pid]
    val = ""
    try:
        r = subprocess.run(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"],
                           capture_output=True, text=True, timeout=10).stdout
        for line in r.splitlines():
            if line.startswith("n"):
                val = line[1:]
                break
    except Exception:
        pass
    _cwd_cache[pid] = val
    return val


def app_of(pid):
    """从进程打开的文件路径反推宿主 .app"""
    if _app_cache is not None and pid in _app_cache:
        return _app_cache[pid]
    apps = set()
    try:
        r = subprocess.run(["lsof", "-p", str(pid)], capture_output=True,
                           text=True, timeout=15).stdout
    except Exception:
        return apps
    for line in r.splitlines():
        if ".app/Contents/" in line:
            name = line.split(".app/Contents/")[0].split("/")[-1]
            if name:
                apps.add(name)
    if _app_cache is not None:
        _app_cache[pid] = apps
    return apps


_app_cache = None


def load_apps_batch(pids):
    """批量获取所有进程的宿主 .app —— 一次 lsof 调用"""
    global _app_cache
    _app_cache = {}
    if not pids:
        return _app_cache
    try:
        r = subprocess.run(["lsof", "-p", ",".join(str(p) for p in pids)],
                           capture_output=True, text=True, timeout=30).stdout
        for line in r.splitlines()[1:]:
            if ".app/Contents/" not in line:
                continue
            parts = line.split()
            if len(parts) >= 2 and parts[1].isdigit():
                name = line.split(".app/Contents/")[0].split("/")[-1]
                if name:
                    _app_cache.setdefault(int(parts[1]), set()).add(name)
    except Exception:
        pass
    return _app_cache


# ─────────────────────────────────────────────────────────────
# 分析逻辑
# ─────────────────────────────────────────────────────────────

def build_groups(info):
    groups = collections.defaultdict(list)
    for pid, b in info.items():
        groups[b["pgid"]].append(pid)
    return groups


_ports_cache = None


def load_ports_batch():
    """批量获取所有监听端口 —— 一次 lsof 调用搞定"""
    global _ports_cache
    _ports_cache = {}
    try:
        r = subprocess.run(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN"],
                           capture_output=True, text=True, timeout=20).stdout
        for line in r.splitlines()[1:]:
            parts = line.split()
            if len(parts) >= 9 and parts[1].isdigit():
                addr = parts[-1]
                if addr.startswith(("*:", "127.0.0.1:", "localhost:", "[::1]:")):
                    _ports_cache.setdefault(int(parts[1]), []).append(addr)
    except Exception:
        pass
    return _ports_cache


_tty_cache = None


def tty_pids():
    """持有终端设备的进程集合 —— 交互式 Agent 会话的特征"""
    global _tty_cache
    if _tty_cache is not None:
        return _tty_cache
    out = set()
    try:
        r = subprocess.run(
            ["lsof", "-a", "-c", "node", "-c", "fish", "-c", "zsh", "-c", "bash",
             "-c", "claude.exe", "-c", "claude", "-c", "codex", "-c", "zcode-cli",
             "-c", "kimi-code", "-c", "head", "-c", "tail",
             "-d", "0", "-d", "1", "-d", "2"],
            capture_output=True, text=True, timeout=20).stdout
        for line in r.splitlines()[1:]:
            parts = line.split()
            if len(parts) >= 2 and parts[1].isdigit():
                out.add(int(parts[1]))
    except Exception:
        pass
    _tty_cache = out
    return out


# Agent 本体进程名 —— 这些还活着说明会话还在用
AGENT_MAIN = ("claude", "codex", "zcode-cli", "kimi-code", "cursor-agent",
              "opencode", "aider", "gemini")


def is_agent_main(b):
    hay = (b["comm"] + " " + b["name"]).lower()
    return any(m in hay for m in AGENT_MAIN)


def is_agentish(b):
    """进程本身像不像 Agent 生态的成员。

    判据要精准，避免把桌面应用的 Helper 误判进来：
      - 排除已知的桌面宿主 Helper
      - 命中 AGENT_MARKERS 中的关键词
    """
    hay = (b["comm"] + " " + b["name"]).lower()
    for ex in EXCLUDE_COMM:
        if ex in hay:
            return False
    return any(m in hay for m in AGENT_MARKERS)


def in_workspace(path):
    """cwd 是否位于工作区目录中 —— CLI Agent 的关键特征"""
    if not path:
        return False
    for root in WORKSPACE_ROOTS:
        if path.startswith(root):
            return True
    return False


def classify_group(pgid, members, info):
    """给一个进程组分类，返回结构化描述"""
    names = [info[p]["comm"] for p in members]

    # 孤儿判定 —— 不能只看 ppid==1。
    #
    # macOS 上所有桌面应用都是 launchd 拉起后 reparent 到 init 的，
    # 根进程 ppid 同样是 1（Arc / Claude / ChatGPT / Lark / Logseq 全都如此），
    # 它们完全健康，绝不能清理。
    #
    # 真正的判据是：根进程自身就是一个 shell/开发工具（bash/node/zsh/...），
    # 且它的 cwd 落在工作区目录里 —— 这说明它是一次 Agent 会话
    # 启动的进程组，会话结束后父进程消失，只剩这一组残留。
    roots = [p for p in members if info[p]["ppid"] not in members]
    if not roots:
        roots = [p for p in members if info[p]["ppid"] == 1] or members

    root_cwds = [proc_cwd(p) for p in roots]
    root_in_ws = any(in_workspace(c) for c in root_cwds)
    root_is_shell = any(
        info[p]["comm"].lower() in ("bash", "zsh", "fish", "sh", "node",
                                    "python3", "head", "tail", "deno", "bun")
        for p in roots)
    root_is_desktop = any(
        any(h in (info[p]["comm"] + " " + info[p]["name"]).lower()
            for h in DESKTOP_HOSTS)
        for p in roots)

    # 残留 = 根在 workspace 里，且根是 shell/开发工具（非桌面应用）
    orphan = root_in_ws and root_is_shell and not root_is_desktop

    all_orphan = all(info[p]["ppid"] not in info or info[p]["ppid"] == 0
                      for p in members)

    # 是否被受保护应用占用
    # 三重识别：进程名、宿主 .app 路径、是否属于桌面应用
    protected = False
    for p in members:
        hay = (info[p]["comm"] + " " + info[p]["name"]).lower()
        if any(h in hay for h in DESKTOP_HOSTS):
            protected = True
            break
    if not protected:
        # 用 lsof 反查宿主 .app —— 兜底，防止桌面应用被误判
        # 批量查询（一次 lsof 覆盖所有成员）
        try:
            r = subprocess.run(["lsof", "-p", ",".join(str(p) for p in members)],
                               capture_output=True, text=True, timeout=25).stdout
            for line in r.splitlines()[1:]:
                if ".app/Contents/" in line:
                    name = line.split(".app/Contents/")[0].split("/")[-1].lower()
                    if any(h in name for h in DESKTOP_HOSTS):
                        protected = True
                        break
        except Exception:
            pass
    # 桌面应用不该出现在 workspace 目录里；若出现也保守跳过
    if not protected:
        for p in members:
            c = proc_cwd(p)
            if c.startswith("/Applications/") or c.startswith("/System/"):
                protected = True
                break

    # 判据 A：进程名像 Agent 生态
    agent_hits = sum(1 for p in members if is_agentish(info[p]))

    # 判据 B：cwd 落在工作区里（更可靠 —— 桌面应用 Helper 的 cwd 是 /）
    ws_members = [p for p in members if in_workspace(proc_cwd(p))]
    ws_ratio = len(ws_members) / len(members) if members else 0

    agent_ratio = agent_hits / len(members) if members else 0

    # workspace 归属（取 cwd 最集中的那个）
    cwds = collections.Counter(proc_cwd(p) for p in members)
    top_cwd, top_n = (cwds.most_common(1)[0] if cwds else ("", 0))

    # 监听端口 —— 后台服务的直接证据（批量查询所有进程一次完成）
    ports = []
    if _ports_cache:
        for p in members:
            ports.extend(_ports_cache.get(p, []))
    ports = sorted(set(ports))

    # 综合判定：既像 Agent 生态，又在��作区里；或本身是孤儿组
    agent_like = (agent_ratio >= 0.5 and ws_ratio >= 0.4 and len(members) >= 2)

    # ── 活跃性判定 ──────────────────────────────────────────
    # 关键安全阀：组里若还有 Agent 本体（claude/codex/...）在跑，
    # 说明会话正在进行，绝不能清理。
    # 交互式 Agent 会话一定持有 tty，进一步强化这个信号。
    ttys = tty_pids()
    agent_mains = [p for p in members if is_agent_main(info[p])]
    live_agent = [p for p in agent_mains if p in ttys]
    has_live_session = bool(agent_mains) or bool(live_agent)

    return {
        "pgid": pgid,
        "members": sorted(members),
        "size": len(members),
        "orphan": orphan,
        "protected": protected,
        "agent_ratio": round(agent_ratio, 2),
        "workspace_ratio": round(ws_ratio, 2),
        "agent_like": agent_like,
        "has_live_session": has_live_session,
        "agent_mains": sorted(agent_mains),
        "cwd": top_cwd,
        "cwd_concentration": f"{top_n}/{len(members)}",
        "ports": sorted(set(ports)),
        "names": names[:12],
        "root": roots,
    }


def analyze(info=None):
    info = info or scan_processes()
    # 批量预取 cwd 与端口 —— 这是性能关键点
    load_cwds_batch(list(info.keys()))
    load_ports_batch()
    groups = build_groups(info)

    units = []
    for pgid, members in groups.items():
        if len(members) < 2:
            continue
        g = classify_group(pgid, members, info)
        # 孤儿组一律纳入（父进程已死 = 明确残留信号）
        # 存活组仅在明确像 Agent 会话时纳入
        if g["orphan"] or g["agent_like"]:
            units.append(g)

    units.sort(key=lambda g: (-g["size"], g["pgid"]))
    return info, units


def my_protected_pids(info):
    """当前会话所在的进程树 —— 绝不能动"""
    me = _libc.getpid()
    prot = set()
    p = me
    for _ in range(16):
        p = _libc.getpgid(p)
        if p <= 1:
            break
        prot.add(p)
    # 所有与我有共同 pgid 的，加上 WorkBuddy 主进程
    for pid, b in info.items():
        if b["pgid"] in prot:
            prot.add(pid)
        if "WorkBuddy" in (b["comm"] + b["name"]):
            prot.add(pid)
    return prot


# ─────────────────────────────────────────────────────────────
# 输出
# ─────────────────────────────────────────────────────────────

def fmt_size(n):
    for unit in ("B", "K", "M", "G"):
        if abs(n) < 1024:
            return f"{n:.1f}{unit}" if unit != "B" else f"{int(n)}B"
        n /= 1024
    return f"{n:.1f}T"


def print_units(units, info, limit=None):
    if not units:
        print("没有发现 Agent 会话残留进程组。系统是干净的。")
        return

    print(f"\n{'─' * 78}")
    print(f"发现 {len(units)} 个 Agent 相关进程组")
    print(f"{'─' * 78}\n")

    shown = units[:limit] if limit else units
    for g in shown:
        if g.get("has_live_session"):
            tag = "活跃会话"
            flag = "· 保留（Agent 仍在运行）"
        elif g["orphan"]:
            tag = "残留组"
            flag = "◆ 可一键清理"
        else:
            tag = "存活组"
            flag = "· 跳过"
        print(f"pgid {g['pgid']:<8} {g['size']:>3} 进程  [{tag}]  {flag}")

        if g["cwd"]:
            print(f"    工作目录: {g['cwd'].replace(os.path.expanduser('~'), '~')}")
        if g["ports"]:
            print(f"    监听端口: {', '.join(g['ports'][:8])}")
        pnames = [n for n in g["names"] if n]
        if pnames:
            print(f"    进程名  : {', '.join(pnames[:7])}")
        print(f"    成员 PID: {', '.join(str(p) for p in g['members'][:12])}"
              f"{' ...' if len(g['members']) > 12 else ''}")
        print()


def cmd_scan(args):
    info, units = analyze()
    if args.json:
        print(json.dumps({
            "version": VERSION,
            "total_processes": len(info),
            "groups": units,
        }, ensure_ascii=False, indent=2))
        return 0

    print(f"\nagentscope v{VERSION} — Agent 会话进程监控")
    print(f"系统总进程: {len(info)}")
    orphan_n = sum(1 for g in units if g["orphan"] and not g["protected"])
    live_n = sum(1 for g in units if not g["orphan"])
    print(f"可清理孤儿组: {orphan_n}   存活组: {live_n}")
    print_units(units, info, limit=args.limit)
    return 0


def cmd_tree(args):
    info = scan_processes()
    pgid = args.pgid
    members = [p for p, b in info.items() if b["pgid"] == pgid]
    if not members:
        print(f"pgid {pgid} 没有存活进程")
        return 1
    print(f"\npgid {pgid} 进程组构成 ({len(members)} 个进程)\n")
    for p in sorted(members):
        b = info[p]
        c = proc_cwd(p).replace(os.path.expanduser("~"), "~")
        print(f"  PID {p:>6}  ppid={b['ppid']:<7} {b['comm'][:24]:<24} {c[:44]}")
    return 0


def kill_group(pgid, dry_run=False, timeout=6):
    """终止整个进程组。

    killpg 在受限环境（沙箱/seatbelt）下可能返回 EPERM —— 因为
    killpg 需要向目标进程组发信号，而沙箱只允许影响自己的进程组。
    此时降级为逐个 kill 成员进程。
    """
    if dry_run:
        print(f"[dry-run] 将终止 pgid {pgid}")
        return True

    members = [p for p in list_pids() if _getpgid(p) == pgid]

    # 二次校验：组内若出现 Agent 本体，说明这个组其实还活着 —— 放弃清理。
    # 防止"扫描时是残留、清理时刚好被启动"的竞态误伤活跃会话。
    live_agent = []
    for pid in members:
        b = proc_bsdinfo(pid)
        if b and is_agent_main(b):
            live_agent.append(pid)
    if live_agent:
        print(f"  跳过 pgid {pgid}: 检测到活跃 Agent 进程 {live_agent}")
        return False

    try:
        os.killpg(pgid, signal.SIGTERM)
        killed_by_pg = True
    except (ProcessLookupError, PermissionError):
        killed_by_pg = False

    if not killed_by_pg:
        # 降级：逐进程终止（先子后父，避免父死留孤儿）
        for pid in _children_first(members):
            try:
                os.kill(pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                pass

    deadline = time.time() + timeout
    while time.time() < deadline:
        if not _pgid_alive(pgid):
            return True
        time.sleep(0.4)

    # 升级到 SIGKILL
    try:
        os.killpg(pgid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        for pid in _children_first(members):
            try:
                os.kill(pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass
    time.sleep(0.8)
    return not _pgid_alive(pgid)


def _getpgid(pid):
    g = _libc.getpgid(pid)
    return g if g >= 0 else -1


def _children_first(members):
    """把成员按「先子后父」排序：父进程先死会留下孤儿"""
    member_set = set(members)
    out = []
    for pid in members:
        b = proc_bsdinfo(pid)
        if not b:
            continue
        # 如果父进程也在组内，则父排在后面
        out.append((0 if b["ppid"] in member_set else 1, pid))
    out.sort(reverse=True)
    return [pid for _, pid in out]


def _pgid_alive(pgid):
    for pid in list_pids():
        b = proc_bsdinfo(pid)
        if b and b["pid"] == pid:
            g = _libc.getpgid(pid)
            if g == pgid:
                return True
    return False


def cmd_clean(args):
    info, units = analyze()
    mine = my_protected_pids(info)

    targets = []
    skipped_live = []
    for g in units:
        if not g["orphan"]:
            continue
        if g["protected"]:
            continue
        # 安全阀 1：组里还有 Agent 本体在跑 → 会话活跃，不动
        if g.get("has_live_session"):
            skipped_live.append(g)
            continue
        # 安全阀 2：当前会话进程树
        if any(p in mine for p in g["members"]):
            continue
        # 安全阀 3：监听端口的组（可能是你要用的服务）
        if g["ports"] and args.keep_ports:
            continue
        targets.append(g)

    if not targets:
        print("没有需要清理的孤儿进程组。")
        if skipped_live:
            print(f"\n（跳过 {len(skipped_live)} 个含活跃 Agent 会话的组）")
        return 0

    total = sum(g["size"] for g in targets)
    print(f"\n准备清理 {len(targets)} 个孤儿进程组，共 {total} 个进程\n")
    for g in targets:
        pnames = ", ".join(n for n in g["names"][:5] if n)
        print(f"  pgid {g['pgid']:<8} {g['size']:>3} 进程  {g['cwd'].replace(os.path.expanduser('~'), '~')[:40]}")
        print(f"      {pnames}")

    if not args.yes:
        print(f"\n这是 dry-run。加 --yes 实际执行，或 --dry-run 明确跳过。")
        if skipped_live:
            print(f"已跳过 {len(skipped_live)} 个含活跃 Agent 会话的组（安全保护）")
        return 0

    print()
    ok = 0
    for g in targets:
        if kill_group(g["pgid"], dry_run=False):
            print(f"  ✓ pgid {g['pgid']} 已清理 ({g['size']} 进程)")
            ok += 1
        else:
            print(f"  ✗ pgid {g['pgid']} 部分残留")

    print(f"\n完成：{ok}/{len(targets)} 个进程组已清理，共回收约 {total} 个进程。")
    if skipped_live:
        print(f"跳过 {len(skipped_live)} 个含活跃 Agent 会话的组（安全保护）")
    return 0


def cmd_watch(args):
    """守护模式：周期扫描，发现孤儿组即清理"""
    print(f"agentscope v{VERSION} — 守护模式")
    print(f"每 {args.interval}s 扫描一次，发现孤儿进程组即清理")
    print(f"保护：当前会话进程树 + 监听端口的组")
    print("Ctrl-C 退出\n")

    seen = set()
    rounds = 0
    try:
        while True:
            rounds += 1
            info, units = analyze()
            mine = my_protected_pids(info)
            fresh = []
            for g in units:
                if not g["orphan"] or g["protected"]:
                    continue
                if g.get("has_live_session"):
                    continue
                if any(p in mine for p in g["members"]):
                    continue
                if g["ports"] and args.keep_ports:
                    continue
                if g["pgid"] in seen:
                    continue
                fresh.append(g)

            if fresh:
                for g in fresh:
                    seen.add(g["pgid"])
                    ok = kill_group(g["pgid"], dry_run=args.dry_run)
                    state = "已清理" if ok else "部分残留"
                    print(f"[{time.strftime('%H:%M:%S')}] pgid {g['pgid']:<8} "
                          f"{g['size']:>3} 进程 {state}  "
                          f"{g['cwd'].replace(os.path.expanduser('~'), '~')[:44]}")
            else:
                if rounds % 12 == 0:
                    print(f"[{time.strftime('%H:%M:%S')}] 第 {rounds} 轮：无新孤儿组 "
                          f"(总进程 {len(info)})")

            time.sleep(args.interval)
    except KeyboardInterrupt:
        print("\n已退出守护模式。")
    return 0


def main():
    ap = argparse.ArgumentParser(
        prog="agentscope",
        description="监控与清理本地 AI Agent 会话及其子进程")
    ap.add_argument("--version", action="version", version=f"agentscope {VERSION}")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("scan", help="列出 Agent 会话与残留进程组")
    p.add_argument("--json", action="store_true", help="JSON 输出")
    p.add_argument("--limit", type=int, default=0, help="最多显示 N 组")
    p.set_defaults(func=cmd_scan)

    p = sub.add_parser("tree", help="查看某个进程组构成")
    p.add_argument("pgid", type=int)
    p.set_defaults(func=cmd_tree)

    p = sub.add_parser("clean", help="清理孤儿进程组")
    p.add_argument("--yes", action="store_true", help="确认执行")
    p.add_argument("--dry-run", action="store_true", help="只预演")
    p.add_argument("--keep-ports", action="store_true", default=True,
                   help="保留监听端口的组（默认开启）")
    p.set_defaults(func=cmd_clean)

    p = sub.add_parser("watch", help="守护模式，周期扫描并自动清理")
    p.add_argument("--interval", type=int, default=30, help="扫描间隔秒数")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--keep-ports", action="store_true", default=True)
    p.set_defaults(func=cmd_watch)

    # Agent 会话监控子命令（agents / panel / node / stats / alerts / whoami）
    try:
        from agentscope_lib.cli import register as _register_agent_cmds
        _register_agent_cmds(sub)
    except ImportError as e:
        print(f"提示：Agent 监控子命令不可用（{e}）", file=sys.stderr)

    args = ap.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
