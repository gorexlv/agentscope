#!/usr/bin/env python3
"""
agentscope-hook — Claude Code / Codex 生命周期钩子

在 Agent 会话结束时，自动清理该会话派生出的子进程
（MCP server、dev server、language server 等），杜绝残留堆积。

原理：
  会话进程与其子进程共享同一个进程组（pgid）。
  hook 执行时，通过扫描进程树找到"祖先链上属于当前会话"的进程组，
  然后终止那些已经变成孤儿（父进程已死）的组。

被 Claude Code 调用时从 stdin 读取 hook JSON（包含 session_id / cwd 等），
从环境变量读 CLAUDE_PROJECT_DIR / CLAUDE_SESSION_ID 等。
"""

import os
import sys
import json
import time
import signal
import subprocess

# 让脚本无论从哪里调用都能找到 agentscope_lib 包
# 优先级：① 同级仓库目录（开发态）  ② ~/.local/lib（安装态）
_PKG_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
for _cand in (_PKG_DIR, os.path.join(os.path.expanduser("~"), ".local", "lib")):
    if os.path.isdir(os.path.join(_cand, "agentscope_lib")) and _cand not in sys.path:
        sys.path.insert(0, _cand)
        break

from agentscope_lib.history import append as audit

HERE = os.path.dirname(os.path.abspath(__file__))
AGENTSCOPE = os.path.join(HERE, "agentscope")


def log(msg):
    sys.stderr.write(f"[agentscope-hook] {msg}\n")
    sys.stderr.flush()


def read_stdin_json():
    """Bound the whole stdin read, including pipes whose writers stay open."""
    import select
    deadline = time.monotonic() + 1
    chunks = []
    try:
        while time.monotonic() < deadline:
            ready, _, _ = select.select([sys.stdin], [], [], max(0, deadline - time.monotonic()))
            if not ready:
                break
            chunk = os.read(sys.stdin.fileno(), 65536)
            if not chunk:
                break
            chunks.append(chunk)
            if sum(map(len, chunks)) > 1024 * 1024:
                return {}
        value = json.loads(b''.join(chunks)) if chunks else {}
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def my_pgid():
    try:
        return os.getpgid(0)
    except Exception:
        return -1


def session_cwds(hook_input):
    """本次会话涉及的工作目录"""
    c = set()
    for k in ("cwd", "project_dir", "workspace_dir"):
        v = hook_input.get(k)
        if v and os.path.isdir(v):
            c.add(os.path.realpath(v))
    for env in ("CLAUDE_PROJECT_DIR", "CLAUDE_WORKSPACE", "PWD"):
        v = os.environ.get(env)
        if v and os.path.isdir(v):
            c.add(os.path.realpath(v))
    return c


def ancestor_pgids():
    """
    本 hook 进程的所有祖先进程组。

    Agent 会话（claude/codex）启动 hook 时，hook 是它的子进程，
    共享同一个 pgid；hook 再派生的子进程也在该组内。
    因此「本次会话的 pgid」可以从祖先链上直接取到 —— 这比按 cwd
    猜测要精确得多，不会误伤同目录下的其他会话残留。
    """
    out = set()
    pid = os.getpid()
    for _ in range(24):
        try:
            pg = os.getpgid(pid)
        except Exception:
            break
        if pg <= 1 or pg in out:
            break
        out.add(pg)
        try:
            nxt = ppid_of(pid)
        except Exception:
            break
        if nxt <= 1:
            break
        pid = nxt
    return out


def ppid_of(pid):
    """取任意进程的父 PID（libproc 方式，ps 在沙箱内不可用）"""
    from agentscope_lib.procstat import proc_parent
    return proc_parent(pid)


def find_session_groups(hook_input, deadline=None):
    """
    找出本次会话遗留的进程组。

    优先用祖先链精确匹配（最可靠）；
    祖先链拿不到时，退化为按工作目录匹配（次优，但更宽松）。
    """
    from agentscope_lib.cleanup import analyze
    _, groups = analyze(deadline=deadline)
    anc = ancestor_pgids()

    # ── 精确路径：祖先 pgid ──
    if anc:
        exact = [g for g in groups if g.get("pgid") in anc]
        if _filter_cleanable(exact):
            log(f"祖先链命中 pgid: {sorted(anc)}")
            return _filter_cleanable(exact)

    # ── 退化路径：按工作目录 ──
    cws = session_cwds(hook_input)
    if not cws:
        return []
    matched = []
    for g in groups:
        cwd = g.get("cwd") or ""
        if not cwd:
            continue
        rcwd = os.path.realpath(cwd)
        for c in cws:
            if rcwd.startswith(c + os.sep) or rcwd == c:
                matched.append(g)
                break
    if matched:
        log(f"按工作目录匹配到 {len(matched)} 个组（未命中祖先链）")
    return _filter_cleanable(matched)


def _filter_cleanable(groups):
    """只保留确认是残留、且可以安全清理的组"""
    out = []
    for g in groups:
        if not g.get("orphan"):
            continue
        if g.get("protected"):
            continue
        if g.get("has_live_session"):
            continue
        if g.get("ports"):
            continue
        out.append(g)
    return out


def cleanup(groups, deadline=None, summary=None):
    from agentscope_lib.cleanup import kill_group
    cleaned = 0
    for index, g in enumerate(groups):
        if deadline is not None and time.monotonic() >= deadline:
            if summary is not None:
                summary['budget_skipped_groups'] = len(groups) - index
            break
        outcome = {}
        if kill_group(g['pgid'], mode='hook', expected=g, deadline=deadline, outcome=outcome):
            if outcome.get('result') == 'cleaned':
                cleaned += len(g['members'])
    return cleaned


def main():
    from agentscope_lib.lifecycle import exit_on_signals
    action = sys.argv[1] if len(sys.argv) > 1 else ''
    if action not in ('session-end', 'subagent-stop', 'scan'):
        return 0
    deadline = time.monotonic() + 25
    summary = {'action': action, 'cleaned_processes': 0, 'budget_skipped_groups': 0}
    with exit_on_signals():
        try:
            hook_input = read_stdin_json()
            summary.update(session_id=hook_input.get('session_id') or os.environ.get('CLAUDE_SESSION_ID'),
                           cwd=hook_input.get('cwd'), reason=hook_input.get('reason', ''))
            transcript = hook_input.get('transcript_path')
            if transcript and os.path.isfile(transcript):
                from agentscope_lib import sessions
                data = sessions.parse_claude_session(transcript)
                for key in ('model', 'input_tokens', 'output_tokens', 'cache_create_tokens', 'cache_read_tokens'):
                    summary[key] = data.get(key)
                summary['cost'] = sessions.calculate_cost(data.get('model'), data.get('input_tokens'), data.get('output_tokens'), data.get('cache_create_tokens'), data.get('cache_read_tokens'))
                summary['cost_estimated'] = sessions.cost_estimated(data.get('model'))
            groups = find_session_groups(hook_input, deadline=deadline)
            summary['candidate_groups'] = [g['pgid'] for g in groups]
            if action == 'scan':
                print(json.dumps(groups, ensure_ascii=False, indent=2))
            else:
                summary['cleaned_processes'] = cleanup(groups, deadline=deadline, summary=summary)
        except (TimeoutError, subprocess.TimeoutExpired):
            summary['result'] = 'deadline exceeded'
        except SystemExit:
            summary['result'] = 'interrupted'
            raise
        except Exception as error:
            summary['result'] = 'error'
            log(str(error))
        finally:
            if action != 'scan':
                audit('sessions', summary)
    return 0


if __name__ == '__main__':
    sys.exit(main())
